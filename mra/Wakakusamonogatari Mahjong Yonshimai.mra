<misterromdescription>
    <rotation>horizontal</rotation>
    <name>Wakakusamonogatari Mahjong Yonshimai (Japan)</name>
    <setname>mj4simai</setname>
    <mameversion>0289</mameversion>
    <year>1996</year>
    <manufacturer>Maboroshi Ware</manufacturer>
    <players>2</players>
    <joystick>0</joystick>
    <rbf>seta2</rbf>
    <platform>Seta</platform>

    <!--
      Image for the seta2 core (rtl/s2_mem.sv, tools/seta2_image.py):

        0x0000000  header: configuration bytes (0x00..0x3F), 93C46 image (0x100..0x17F)
        0x0100000  TMP68301 program (68000 byte order; gundamex 0x500000-0x57FFFF at +0x200000)
        0x0500000  X1-010 samples
        0x0900000  graphics ROM (MAME's "video" region as it is)

      Made by tools/make_mra.py from MAME 0.289 (src/mame/seta/seta2.cpp); expects the MAME 0.289 merged romset or
      the split sets: parts are found by name and CRC.

      DIP switches (ioctl index 254): byte 0 is DSW1 (MAME's DSW1 port, bits 7:0), byte 1 DSW2, byte 2 board
      jumpers; a 1 is "off".  MAME's default is FFCCFF.
    -->
    <switches default="FF,CC,FF" base="16">
        <dip bits="0,1,2" name="Coinage" ids="5C/1C,4C/1C,3C/1C,2C/1C,1C/4C,1C/3C,1C/2C,1C/1C"/>
        <dip bits="3" name="Demo Sounds" ids="Off,On"/>
        <dip bits="4" name="Tumo Pin" ids="Off,On"/>
        <dip bits="5" name="Flip Screen" ids="On,Off"/>
        <dip bits="6" name="Free Play" ids="On,Off"/>
        <dip bits="7" name="Service Mode" ids="On,Off"/>
        <dip bits="8,9,10" name="Difficulty" ids="4,3,2,1,0,7,6,5"/>
        <dip bits="11" name="Allow Continue" ids="No,Yes"/>
        <dip bits="12" name="Select Girl" ids="Yes,No"/>
        <dip bits="13" name="Com Put" ids="On,Off"/>
        <dip bits="14" name="Unknown" ids="On,Off"/>
        <dip bits="15" name="Unknown" ids="On,Off"/>
    </switches>

    <rom index="0" zip="mj4simai.zip" md5="b2b207d9e011d2c7e25b48c5303ffeb8" address="0x30000000">
        <!-- header: configuration (tools/seta2_image.py) -->
        <part>53 32 02 08 DE AF 15 00 05 02 20 00 65 00 80 01 06 01 02 00 0F 00 F0 00 FF FF 07 00 00 00 08 00 1F 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>
        <part repeat="0x3">00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>
        <part repeat="0x3ffc">00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>
        <!-- maincpu: the TMP68301 program (68000 byte order) -->
        <interleave output="16">
            <part name="ll.u2" crc="7be9c781" offset="0x0" length="0x80000" map="01"/>
            <part name="lh1.u3" crc="82aa3f72" offset="0x0" length="0x80000" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="hl.u4" crc="226063b7" offset="0x0" length="0x80000" map="01"/>
            <part name="hh.u5" crc="23aaf8df" offset="0x0" length="0x80000" map="10"/>
        </interleave>
        <part repeat="0x8000">00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>
        <!-- x1snd: the X1-010 samples -->
        <part name="cha-07.u32" crc="817519ee" offset="0x0" length="0x400000"/>
        <!-- video: the graphics ROM, 8 bytes per row of a tile (MAME's region as it is) -->
        <interleave output="64">
            <part name="cha-03.u16" crc="d367429a" offset="0x0" length="0x400000" map="00000021"/>
            <part name="cha-05.u15" crc="e94ec40a" offset="0x0" length="0x400000" map="00002100"/>
            <part name="cha-01.u21" crc="35f47b37" offset="0x0" length="0x400000" map="00210000"/>
            <part repeat="0x200000" map="21000000">00 00</part>
        </interleave>
        <interleave output="64">
            <part name="cha-04.u18" crc="7f2008c3" offset="0x0" length="0x400000" map="00000021"/>
            <part name="cha-06.u17" crc="5cb0b3a9" offset="0x0" length="0x400000" map="00002100"/>
            <part name="cha-02.u22" crc="f6346860" offset="0x0" length="0x400000" map="00210000"/>
            <part repeat="0x200000" map="21000000">00 00</part>
        </interleave>
    </rom>

    <buttons names="-,-,-,-,Start,Coin" default="Start,Select"/>
</misterromdescription>
