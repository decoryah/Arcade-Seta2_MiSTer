<misterromdescription>
    <rotation>horizontal</rotation>
    <name>Deer Hunting USA V1</name>
    <setname>deerhunte</setname>
    <parent>deerhunt</parent>
    <mameversion>0289</mameversion>
    <year>2000</year>
    <manufacturer>Sammy USA Corporation</manufacturer>
    <players>1</players>
    <joystick>0</joystick>
    <rbf>seta2pen</rbf>
    <platform>Seta</platform>

    <!--
      Image for the seta2 core (rtl/s2_mem.sv, tools/seta2_image.py):

        0x0000000  header: configuration bytes (0x00..0x3F), 93C46 image (0x100..0x17F)
        0x0100000  TMP68301 program (68000 byte order; gundamex 0x500000-0x57FFFF at +0x200000)
        0x0500000  X1-010 samples
        0x0900000  graphics ROM (MAME's "video" region as it is)

      Made by tools/make_mra.py from MAME 0.289 (src/mame/seta/seta2.cpp); expects the MAME 0.289 merged romset or
      the split sets: parts are found by name and CRC.

      DIP switches (ioctl index 254): byte 0 is DSW1 (MAME's DSW1 port, bits 7:0), byte 1 DSW2, byte 2 board
      jumpers; a 1 is "off".  MAME's default is FFFFFF.
    -->
    <switches default="FF,FF,FF" base="16">
        <dip bits="0,1,2" name="Coin A" ids="1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,4C/1C,2C/1C,1C/1C"/>
        <dip bits="3,4,5" name="Coin A (switches 4-6)" ids="1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,4C/1C,2C/1C,1C/1C"/>
        <dip bits="6" name="Discount To Continue" ids="On,Off"/>
        <dip bits="7" name="Service Mode" ids="On,Off"/>
        <dip bits="8" name="Vert. Flip Screen" ids="On,Off"/>
        <dip bits="9" name="Horiz. Flip Screen" ids="On,Off"/>
        <dip bits="10" name="Demo Sounds" ids="Off,On"/>
        <dip bits="11,12" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
        <dip bits="13" name="Blood Color" ids="Yellow,Red"/>
        <dip bits="14" name="Lives" ids="4,3"/>
        <dip bits="15" name="Gun Type" ids="Hand Gun,Pump Action"/>
    </switches>

    <rom index="0" zip="deerhunte.zip|deerhunt.zip" md5="047f357356fcbc4fcb319d0c71a82eaf" address="0x30000000">
        <!-- header: configuration (tools/seta2_image.py) -->
        <part>53 32 07 00 AB AA 12 00 BE 01 23 00 60 00 40 01 06 01 02 00 0F 00 F0 00 FF FF 07 00 00 00 08 00 1F 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>
        <part repeat="0x3">00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>
        <part repeat="0x3ffc">00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>
        <!-- maincpu: the TMP68301 program (68000 byte order) -->
        <interleave output="16">
            <part name="as_0906_e01.u06" crc="103e3ba3" offset="0x0" length="0x100000" map="01"/>
            <part name="as_0907_e01.u07" crc="ddeb0f97" offset="0x0" length="0x100000" map="10"/>
        </interleave>
        <part repeat="0x8000">00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>
        <!-- x1snd: the X1-010 samples -->
        <part name="as0905m01.u18" crc="8d8165bb" offset="0x0" length="0x400000"/>
        <!-- video: the graphics ROM, 8 bytes per row of a tile (MAME's region as it is) -->
        <interleave output="64">
            <part name="as0901m01.u38" crc="1d6acf8f" offset="0x0" length="0x800000" map="00000021"/>
            <part name="as0902m01.u39" crc="c7ca2128" offset="0x0" length="0x800000" map="00002100"/>
            <part name="as0903m01.u40" crc="e8ef81b3" offset="0x0" length="0x800000" map="00210000"/>
            <part name="as0904m01.u41" crc="d0f97fdc" offset="0x0" length="0x800000" map="21000000"/>
        </interleave>
    </rom>
    <nvram index="4" size="8192"/>

    <buttons names="Trigger,Pump,-,-,Start,Coin" default="A,B,Start,Select"/>
</misterromdescription>
