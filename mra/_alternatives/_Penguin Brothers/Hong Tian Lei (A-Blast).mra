<misterromdescription>
    <rotation>horizontal</rotation>
    <name>Hong Tian Lei (A-Blast) (Japan)</name>
    <setname>ablast</setname>
    <parent>penbros</parent>
    <mameversion>0289</mameversion>
    <year>2000</year>
    <manufacturer>Subsino</manufacturer>
    <players>2</players>
    <joystick>8</joystick>
    <rbf>seta2pen</rbf>
    <platform>Seta</platform>

    <!--
      Image for the seta2 core (rtl/s2_mem.sv, tools/seta2_image.py):

        0x0000000  header: configuration bytes (0x00..0x3F), 93C46 image (0x100..0x17F)
        0x0100000  TMP68301 program (68000 byte order; gundamex 0x500000-0x57FFFF at +0x200000)
        0x0500000  X1-010 samples
        0x0900000  graphics ROM (MAME's "video" region as it is)

      Made by tools/make_mra.py from MAME 0.289 (src/mame/seta/seta2.cpp); expects the MAME 0.289 merged romset or
      the split sets: parts are found by name and CRC.

      DIP switches (ioctl index 254): byte 0 is DSW1 (MAME's DSW1 port, bits 7:0), byte 1 DSW2, byte 2 board
      jumpers; a 1 is "off".  MAME's default is FFFFFF.
    -->
    <switches default="FF,FF,FF" base="16">
        <dip bits="0" name="Service Mode" ids="On,Off"/>
        <dip bits="1" name="Flip Screen" ids="On,Off"/>
        <dip bits="2" name="Unused (SW1:3)" ids="On,Off"/>
        <dip bits="3" name="Demo Sounds" ids="Off,On"/>
        <dip bits="4,5" name="Coin A" ids="1C/2C,2C/1C,3C/1C,1C/1C"/>
        <dip bits="6,7" name="Coin B" ids="1C/2C,2C/1C,3C/1C,1C/1C"/>
        <dip bits="8,9" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
        <dip bits="10,11" name="Lives" ids="2,4,5,3"/>
        <dip bits="12,13" name="Bonus Life" ids="Every 250k,150k and 500k,None,200k and 700k"/>
        <dip bits="14,15" name="Winning Rounds (Player VS Player)" ids="5,3,4,2"/>
    </switches>

    <rom index="0" zip="ablast.zip|penbros.zip" md5="1be5227f32a77cd7e765d52ebde3dd3a" address="0x30000000">
        <!-- header: configuration (tools/seta2_image.py) -->
        <part>53 32 06 40 AB AA 12 00 BD 01 3F 00 65 00 40 01 06 01 03 00 0F 00 E0 00 FF FF 03 00 00 00 04 00 0F 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>
        <part repeat="0x3">00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>
        <part repeat="0x3ffc">00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>
        <!-- maincpu: the TMP68301 program (68000 byte order) -->
        <interleave output="16">
            <part name="a-blast_twn_u06.u06" crc="e62156d7" offset="0x0" length="0x80000" map="01"/>
            <part name="a-blast_twn_u07.u07" crc="d4ddc16b" offset="0x0" length="0x80000" map="10"/>
        </interleave>
        <part repeat="0xc000">00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>
        <!-- x1snd: the X1-010 samples -->
        <part name="a-blast_twn_u18.u18" crc="de4e65e2" offset="0x0" length="0x200000"/>
        <part repeat="0x8000">00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>
        <!-- video: the graphics ROM, 8 bytes per row of a tile (MAME's region as it is) -->
        <interleave output="64">
            <part name="a-blast_twn_u38.u38" crc="090923da" offset="0x0" length="0x400000" map="00000021"/>
            <part name="a-blast_twn_u39.u39" crc="6bb17d83" offset="0x0" length="0x400000" map="00002100"/>
            <part name="a-blast_twn_u40.u40" crc="db94847d" offset="0x0" length="0x400000" map="00210000"/>
            <part repeat="0x200000" map="21000000">00 00</part>
        </interleave>
    </rom>

    <buttons names="Bomb,Jump,-,-,Start,Coin" default="A,B,Start,Select"/>
</misterromdescription>
